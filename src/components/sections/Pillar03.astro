---
/** PILLAR-03 — 2×2 cards: summary row + large icon + bullet list (Home 3). */
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Hatch from '../ui/Hatch.astro';
import { pillars } from '../../data/content';
---
<section class="bg-white px-10 pb-[60px] pt-20" data-section="PILLAR-03">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-12">
    <SectionHeader eyebrow="Core pillars" title="Core Pillars of Architecture" width={1360} />
    <div class="grid grid-cols-2 items-start gap-6">
      {
        pillars.map((p) => (
          <article class="flex flex-col overflow-hidden rounded-lg border border-line">
            <div class="flex items-start gap-8 border-b border-black/[.11] p-8">
              <h3 class="t-h5 w-[244px] shrink-0">{p.card ?? p.short}</h3>
              <p class="t-b3 line-clamp-2 text-ink-2">{p.summary}</p>
            </div>
            <div class="flex items-start gap-8 p-8">
              <div class="grid size-[244px] shrink-0 place-items-center text-zinc-300">
                <Icon name={p.icon as any} size={80} />
              </div>
              <ul class="flex min-w-0 flex-1 flex-col">
                {p.bullets.map((b) => (
                  <li class="t-b3 border-b border-black/[.11] py-4 text-ink-2">{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <Hatch class="relative left-1/2 mt-12 w-screen max-w-[1440px] -translate-x-1/2" />
</section>
