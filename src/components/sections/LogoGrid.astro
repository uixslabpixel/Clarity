---
/** LOGO-02 — 3×2 bordered client logo grid (Home 3). */
import ClientLogo from '../ui/ClientLogo.astro';
import Hatch from '../ui/Hatch.astro';
import { clients } from '../../data/content';
---
<section class="bg-white px-4 pb-12 pt-2 md:px-10 md:pb-[61px]" data-section="LOGO-02">
  <div class="mx-auto grid max-w-[1360px] grid-cols-2 gap-3 md:grid-cols-3 md:gap-5">
    {
      clients.slice(0, 6).map((c) => (
        <div class="grid h-[120px] place-items-center md:h-[180px] lg:h-[240px] border border-line text-black/80">
          <ClientLogo name={c} height={44} class="scale-[.45] md:scale-75 lg:scale-100" />
        </div>
      ))
    }
  </div>
  <Hatch class="-mx-4 w-auto md:-mx-10 mt-12" />
</section>
