---
/** BLOG-02 — briefing cards slider with arrows (Home 3). */
import SectionHeader from '../ui/SectionHeader.astro';
import SliderNav from '../ui/SliderNav.astro';
import Hatch from '../ui/Hatch.astro';
import BlogCard from '../cards/BlogCard.astro';
import { posts } from '../../data/content';
const items = [...posts, ...posts];
---
<section class="overflow-hidden bg-white px-4 pb-12 pt-12 md:px-10 md:pb-[60px] md:pt-20" data-section="BLOG-02">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-10 md:gap-12">
    <SectionHeader eyebrow="Blog" title="Governance Briefings" width={300} />
    <div class="flex flex-col gap-6" data-slider="track">
      <div class="-mx-4 flex snap-x snap-mandatory gap-4 overflow-x-auto px-4 [scrollbar-width:none] md:mx-0 md:overflow-visible md:px-0" data-track>
        {items.map((p) => <BlogCard {...p} category="Corporate Strategy Hub" href={`/insights/${p.slug}`} class="w-[300px] shrink-0 snap-start md:w-[368px]" />)}
      </div>
      <SliderNav />
    </div>
  </div>
  <Hatch class="-mx-4 w-auto md:-mx-10 mt-12" />
</section>
