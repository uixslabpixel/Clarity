---
/** HERO-01 — full-bleed image, centered headline, two CTAs, video card, logo strip (Home 1). */
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';
import VideoCard from '../ui/VideoCard.astro';
import ClientLogo from '../ui/ClientLogo.astro';
import { clients } from '../../data/content';
---
<section class="relative h-[900px] overflow-hidden bg-black text-white" data-section="HERO-01">
  <Media tone="duotone" class="absolute inset-0 size-full scale-110" loading="eager" data-parallax="60" />
  <div class="absolute inset-x-4 top-[200px] flex flex-col items-center gap-8 text-center md:inset-x-auto md:left-1/2 md:top-[220px] md:w-[636px] md:-translate-x-1/2">
    <h1 data-reveal class="t-hero">Engineering Enterprise <br />Alpha governance.</h1>
    <div data-reveal class="flex gap-4">
      <Button href="/contact" variant="light">Book a Call</Button>
      <Button href="/contact" variant="ghost" chevron={false}>Talk to Sales</Button>
    </div>
  </div>
  <VideoCard class="absolute left-1/2 top-[719px] -translate-x-1/2 md:top-[697px]" />
  <div
    class="absolute left-1/2 top-[846px] flex w-[1080px] md:top-[838px] -translate-x-1/2 items-start justify-center gap-4 text-white/60 [mask-image:linear-gradient(to_right,transparent_8%,black_40%,black_60%,transparent_92%)]"
  >
    {clients.map((c) => <ClientLogo name={c} height={21} />)}
  </div>
</section>
