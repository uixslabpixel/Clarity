---
import Icon from './Icon.astro';
interface Props {
  items: string[];
  active?: number;
  class?: string;
}
const { items, active = 0, class: cls = '' } = Astro.props;
---
<div class={`flex flex-col gap-6 ${cls}`} data-filter>
  <div class="flex h-[29px] items-center justify-between">
    <div class="flex items-center gap-6 font-heading text-[24px] leading-[1.2]" role="tablist">
      {
        items.map((t, i) => (
          <button type="button" role="tab" aria-selected={i === active ? 'true' : 'false'} data-filter-value={t} class={`whitespace-nowrap transition-colors ${i === active ? 'text-black' : 'text-ink-4 hover:text-black'}`}>
            {t}
          </button>
        ))
      }
    </div>
    <button type="button" aria-label="Search" class="text-ink-5 transition-colors hover:text-black" data-search-toggle><Icon name="search" size={18} /></button>
  </div>
  <span class="h-px w-full bg-line"></span>
</div>
