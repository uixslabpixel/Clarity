---
/** PROCESS-02 — accordion steps with a large image (Home 2). */
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Media from '../ui/Media.astro';
import { process } from '../../data/content';
import { processImages } from '../../data/images';
---
<section class="bg-white px-4 py-12 md:px-10 md:py-20 lg:px-[max(40px,calc((100%-1200px)/2))]" data-section="PROCESS-02">
  <div class="mx-auto flex max-w-[1200px] flex-col gap-10 lg:gap-16">
    <div class="flex flex-col gap-4">
      <Eyebrow>How it works</Eyebrow>
      <span class="h-px w-full bg-line"></span>
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between md:gap-8">
        <h2 data-reveal class="t-h2">Our 4-Step Engagement Model</h2>
        <Button href="/services" variant="soft">Access Domain Strategy</Button>
      </div>
    </div>
    <div class="flex flex-col items-stretch gap-8 lg:flex-row" data-accordion data-autoplay="7">
      <ol class="flex flex-col lg:w-[380px] lg:shrink-0">
        {
          process.map((step, i) => (
            <li class="group relative flex flex-col gap-8 border-t border-line data-open:bg-gradient-to-b data-open:from-transparent data-open:to-black/5" data-accordion-item data-image={processImages[i % processImages.length]} data-open={i === 0 ? '' : undefined}>
              <span class="absolute -top-px left-0 h-px w-full origin-left bg-black" style={`transform:scaleX(${i === 0 ? 0.5 : 0})`} data-progress />
              <div class="flex flex-col px-4 pb-6 pt-6 md:px-8 md:pb-8 lg:pt-0">
                <button type="button" class="t-h5 text-left" data-accordion-trigger>{step.title}</button>
                <div class={`overflow-hidden ${i === 0 ? '' : 'h-0'}`} data-accordion-panel>
                  <p class="t-b3 pt-6 text-ink-2 lg:pt-12">{step.text}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      <Media src={processImages[0]} data-accordion-image data-reveal="media" class="h-[320px] rounded md:h-[480px] lg:h-auto lg:min-h-[480px] lg:min-w-0 lg:grow lg:basis-0" />
    </div>
  </div>
</section>
