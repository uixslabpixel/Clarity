---
/** ARTICLE-01 — rich text column + sticky "In this page" table of contents. */
import Hatch from '../ui/Hatch.astro';
import Toc from '../ui/Toc.astro';
interface Props {
  toc: { id: string; label: string }[];
  class?: string;
}
const { toc, class: cls = 'pb-12 pt-24 lg:pb-20 lg:pt-[120px]' } = Astro.props;
---
<section class={`relative bg-white px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))] ${cls}`} data-section="ARTICLE-01">
  <Hatch class="absolute inset-x-0 top-0" />
  <div class="mx-auto flex max-w-[1132px] flex-col-reverse items-stretch gap-10 lg:flex-row lg:items-start lg:justify-between lg:gap-8">
    <article class="prose-clarity min-w-0 max-w-[800px] flex-1" data-article>
      <slot />
    </article>
    <Toc items={toc} class="lg:sticky lg:top-24 lg:max-w-[268px] lg:flex-1" />
  </div>
</section>
