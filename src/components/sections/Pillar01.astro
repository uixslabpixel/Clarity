---
/** PILLAR-01 — dark split: accordion list + swapping image stack (Home 1). */
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import Media from '../ui/Media.astro';
import { pillars } from '../../data/content';
import { pillarImages } from '../../data/images';

interface Props {
  eyebrow?: string;
  title?: string;
  items?: { title: string; text: string }[];
}
const { eyebrow = 'Core pillars', title = 'Core Pillars of Architecture', items = pillars } = Astro.props;
---
<section class="bg-black px-4 py-12 text-white md:px-10 lg:py-[98px]" data-section="PILLAR-01">
  <div
    class="mx-auto grid max-w-[1170px] grid-cols-1 gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,600px)_minmax(0,575px)] lg:grid-rows-[auto_1fr] lg:justify-between lg:gap-y-0"
    data-accordion
  >
    <div class="flex flex-col gap-2 lg:col-start-1 lg:row-start-1 lg:gap-3.5">
      <Eyebrow tone="light">{eyebrow}</Eyebrow>
      <h2 data-reveal class="t-h2 lg:max-w-[400px]">{title}</h2>
    </div>
    <div class="flex h-[337px] flex-col gap-3 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:h-auto lg:gap-4" data-accordion-media>
      {
        items.map((item, i) => (
          <div
            class="min-h-0 basis-0 grow overflow-hidden rounded opacity-30 transition-[flex-basis,flex-grow,opacity] duration-700 ease-[cubic-bezier(.65,0,.35,1)] data-open:shrink-0 data-open:grow-0 data-open:basis-[168px] data-open:opacity-100 lg:data-open:basis-[519px]"
            data-open={i === 0 ? '' : undefined}
          >
            <Media src={pillarImages[i % pillarImages.length]} sizes="(min-width: 1024px) 575px, 100vw" tone="dark" class="size-full" alt={item.title} />
          </div>
        ))
      }
    </div>
    <ul class="flex flex-col gap-4 lg:col-start-1 lg:row-start-2 lg:gap-6 lg:pt-[396px]">
      {
        items.map((item, i) => (
          <li class={`group flex flex-col ${i > 0 ? 'border-t border-white/20 pt-4 lg:pt-6' : ''}`} data-accordion-item data-open={i === 0 ? '' : undefined}>
            <button type="button" class="flex w-full items-center gap-4 text-left" data-accordion-trigger>
              <span class="hidden size-4 shrink-0 place-items-center rounded-full bg-white/10 group-data-open:grid">
                <Icon name="chevron-right" size={8} />
              </span>
              <span class="t-b3 flex-1 text-paper-3 transition-colors hover:text-white group-data-open:t-h6 group-data-open:text-white lg:group-data-open:text-[24px] lg:group-data-open:leading-[1.2] lg:group-data-open:tracking-normal">{item.title}</span>
            </button>
            <div class={`overflow-hidden ${i === 0 ? '' : 'h-0'}`} data-accordion-panel>
              <p class="t-b4 pl-8 pt-2 text-paper-2 lg:text-[16px] lg:leading-[1.3] lg:text-white">{item.text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>
