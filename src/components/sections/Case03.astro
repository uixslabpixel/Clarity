---
/** CASE-03 — testimonial-style case card with two metrics and slider controls (Home 3). */
import Eyebrow from '../ui/Eyebrow.astro';
import Media from '../ui/Media.astro';
import Wordmark from '../ui/Wordmark.astro';
import ClientLogo from '../ui/ClientLogo.astro';
import Icon from '../ui/Icon.astro';
import { testimonials } from '../../data/content';
const metricSets = [
  [
    { value: '34%', label: 'Average efficiency gain across clients.' },
    { value: '$42M+', label: 'Restructuring overhead costs mitigated.' },
  ],
  [
    { value: '96%', label: 'Fulfilment SLA restored within eight weeks.' },
    { value: '19%', label: 'EBITDA improvement in 120 days.' },
  ],
  [
    { value: '61%', label: 'Faster board decisions after governance reset.' },
    { value: '$140M', label: 'Capital redeployed into growth mandates.' },
  ],
  [
    { value: '18.2%', label: 'EBITDA optimization across distribution.' },
    { value: '3', label: 'Approval tiers removed from core workflows.' },
  ],
];
const slides = testimonials.map((t, i) => ({ ...t, metrics: metricSets[i % metricSets.length] }));
---
<div class="flex w-full flex-col items-center gap-10 md:gap-14" data-section="CASE-03">
  <div class="flex w-full max-w-[700px] flex-col items-center gap-3.5 text-center">
    <Eyebrow>Case study</Eyebrow>
    <h2 data-reveal class="t-h2">Featured Proof of Concept</h2>
  </div>
  <div class="flex w-full flex-col gap-6" data-slider="fade" data-autoplay="9">
    <div class="grid">
    {slides.map((t, i) => (
    <article class="col-start-1 row-start-1 flex w-full flex-col gap-12 overflow-hidden rounded border border-line bg-white p-5 md:gap-[88px] md:p-8" data-slide aria-hidden={i === 0 ? undefined : 'true'} style={i === 0 ? undefined : 'visibility:hidden;opacity:0'}>
      <div class="flex flex-col-reverse items-start gap-6 md:flex-row md:justify-between" data-slide-part>
        <div class="flex items-center gap-3">
          <Media class="size-[50px] rounded-full" src={t.photo ?? undefined} alt={`Photo of ${t.name}`} />
          <div class="t-b3 flex flex-col gap-1">
            <span>{t.name}</span>
            <span class="text-ink-2">{t.role}</span>
          </div>
        </div>
        <div class="flex items-center gap-[11px]">
          <Wordmark size={22} />
          <span class="h-[22px] w-px bg-black/20"></span>
          <ClientLogo name={t.company || 'Owlearn'} height={19} />
        </div>
      </div>
      <div class="flex max-w-[720px] flex-col gap-10" data-slide-part>
        <blockquote class="t-b1">{t.quote}</blockquote>
        <div class="flex flex-col gap-6 md:flex-row md:items-center md:gap-10">
          {
            t.metrics.map((m, i) => (
              <>
                {i > 0 && <span class="h-px w-full bg-line md:h-[59px] md:w-px" />}
                <div class="flex flex-1 flex-col gap-2">
                  <p class="t-h3">{m.value}</p>
                  <p class="t-b3 text-ink-2">{m.label}</p>
                </div>
              </>
            ))
          }
        </div>
      </div>
    </article>
    ))}
    </div>
    <div class="flex items-center justify-between">
      <button type="button" data-prev aria-label="Previous" class="grid size-6 place-items-center rounded-full bg-black/[.04]"><Icon name="chevron-left" size={12} /></button>
      <div class="flex w-20 gap-1" data-dots>
        {slides.map((_, i) => <span class={`h-[3px] flex-1 rounded-full transition-colors ${i === 0 ? 'bg-black' : 'bg-black/20'}`} />)}
      </div>
      <button type="button" data-next aria-label="Next" class="grid size-6 place-items-center rounded-full bg-black text-white"><Icon name="chevron-right" size={12} /></button>
    </div>
  </div>
</div>
