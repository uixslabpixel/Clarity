---
/** STATS-03 — three centred stats separated by dividers (Home 3). */
import { stats } from '../../data/content';
interface Props {
  items?: { value: string; label: string }[];
}
const { items = stats } = Astro.props;
---
<div class="flex flex-col items-center justify-center gap-10 md:flex-row md:gap-8 lg:gap-16" data-section="STATS-03">
  {
    items.map((s, i) => (
      <>
        {i > 0 && <span class="h-px w-full bg-line md:h-[97px] md:w-px" />}
        <div data-reveal class="flex w-full max-w-[250px] flex-col gap-4 text-center md:gap-[22px]">
          <p class="t-h1" data-count>{s.value}</p>
          <p class="t-b3 text-ink-2">{s.label}</p>
        </div>
      </>
    ))
  }
</div>
