---
/** PROCESS-01 — four columns, the active one expands to show its copy (Home 1). */
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import { process } from '../../data/content';
interface Props {
  eyebrow?: string;
  title?: string;
  cta?: string;
  items?: { title: string; text: string }[];
}
const { eyebrow = 'How it works', title = 'Our 4-Step Engagement Model', cta = 'Access Domain Strategy', items = process } = Astro.props;
---
<section class="bg-white px-[154px] pb-[104px] pt-20" data-section="PROCESS-01">
  <div class="mx-auto flex max-w-[1132px] flex-col gap-20">
    <SectionHeader eyebrow={eyebrow} title={title}>
      <Button href="/services" variant="soft">{cta}</Button>
    </SectionHeader>
    <ol class="flex items-start gap-2" data-tabs data-active="0">
      {
        items.map((step, i) => {
          const active = i === 0;
          return (
            <li
              class={`relative flex flex-col gap-8 border-t border-line ${active ? 'w-[380px] shrink-0 bg-gradient-to-b from-transparent to-black/5' : 'h-[262px] min-w-0 flex-1'}`}
              data-tab-item
            >
              <span class={`absolute -top-px left-0 h-px ${active ? 'w-1/2 bg-black' : 'w-0'}`} data-progress />
              <div class="flex flex-1 flex-col gap-12 px-8 pb-8">
                <div class="flex flex-col gap-2">
                  <span class="t-label text-ink-3">{String(i + 1).padStart(2, '0')}</span>
                  <h3 class={`t-h5 ${active ? 'max-w-[160px]' : ''}`}>{step.title}</h3>
                </div>
                <p class={`t-b3 ${active ? 'text-ink-2' : 'h-[72px] overflow-hidden text-ink-3 opacity-0'}`}>{step.text}</p>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>
