---
/** STATS-01 — dark split: heading left, numbered rows right (Home 1). */
import Eyebrow from '../ui/Eyebrow.astro';
import { stats } from '../../data/content';
interface Props {
  eyebrow?: string;
  title?: string;
  items?: { value: string; label: string }[];
}
const { eyebrow = 'Number', title = 'Institutional Progress Delivered', items = stats } = Astro.props;
---
<section class="bg-black px-[135px] py-[88px] text-white" data-section="STATS-01">
  <div class="mx-auto flex max-w-[1170px] items-start gap-8">
    <div class="flex max-w-[480px] flex-1 flex-col gap-3.5">
      <Eyebrow tone="light">{eyebrow}</Eyebrow>
      <h2 class="t-h2">{title}</h2>
    </div>
    <dl class="flex flex-1 flex-col gap-10">
      {
        items.map((s) => (
          <div class="flex flex-col gap-8 border-t border-white/20 pt-8">
            <div class="flex items-center justify-between">
              <dt class="t-h1" data-count>{s.value}</dt>
              <dd class="t-b3 w-[292px] text-paper-2">{s.label}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>
