---
/** CASE-06 — edge-faded reel of case portraits; centre card carries the client mark (Home 2). */
import Media from '../ui/Media.astro';
import Wordmark from '../ui/Wordmark.astro';
import ClientLogo from '../ui/ClientLogo.astro';
---
<section class="overflow-hidden bg-white py-12 md:py-20" data-section="CASE-06">
  <div class="[mask-image:linear-gradient(to_right,transparent_0%,black_26%,black_74%,transparent_100%)]">
  <div class="relative left-1/2 w-max -translate-x-1/4" data-marquee="30">
    <div class="flex w-max">
    {
      Array.from({ length: 10 }).map((_, i) =>
        i % 5 === 2 ? (
          <article class="relative flex h-[340px] w-[250px] md:h-[430px] md:w-[320px] mr-4 shrink-0 md:mr-8 flex-col justify-end overflow-hidden rounded bg-black/[.04] p-6">
            <Media class="absolute inset-0 size-full" />
            <div class="relative flex items-center gap-[11px] text-white">
              <Wordmark size={22} />
              <span class="h-[22px] w-px bg-white/40" />
              <ClientLogo name="Owlearn" height={19} />
            </div>
          </article>
        ) : (
          <div class="h-[340px] w-[250px] md:h-[430px] md:w-[320px] mr-4 shrink-0 md:mr-8 rounded bg-black/[.04]" />
        ),
      )
    }
    </div>
  </div>
  </div>
</section>
