---
/** PRINCIPLE-02 — vertical tabs with a large image (About 2). */
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Media from '../ui/Media.astro';
import { principles } from '../../data/about';
---
<section class="bg-white px-10 py-20" data-section="PRINCIPLE-02">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-16">
    <div class="flex flex-col gap-4">
      <Eyebrow>Core principles</Eyebrow>
      <span class="h-px w-full bg-line"></span>
      <div class="flex items-end justify-between gap-8">
        <h2 class="t-h2">Our Practice's Core Principles</h2>
        <Button href="/contact" variant="soft">Book a Call</Button>
      </div>
    </div>
    <div class="flex items-stretch gap-8" data-tabs data-active="0">
      <ol class="flex w-[380px] shrink-0 flex-col">
        {
          principles.map((p, i) =>
            i === 0 ? (
              <li class="relative flex size-[380px] flex-col gap-8 border-t border-line bg-gradient-to-b from-[#f4f1ec]/0 to-[#f4f1ec]" data-tab-item>
                <span class="absolute -top-px left-0 h-px w-1/2 bg-black" data-progress />
                <div class="flex flex-1 flex-col justify-between px-8 pb-8">
                  <h3 class="t-h5">{p.title}</h3>
                  <p class="t-b3 text-ink-2">{p.text}</p>
                </div>
              </li>
            ) : (
              <li class="border-t border-line pt-8" data-tab-item>
                <button type="button" class="t-h5 w-full px-8 pb-8 text-left">{p.title}</button>
              </li>
            ),
          )
        }
      </ol>
      <Media class="flex-1" />
    </div>
  </div>
</section>
