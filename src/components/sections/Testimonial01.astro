---
/** TESTI-01 — split testimonial: photo left, quote right, arrows (Home 1). */
import Eyebrow from '../ui/Eyebrow.astro';
import SliderNav from '../ui/SliderNav.astro';
import Media from '../ui/Media.astro';
import { testimonials } from '../../data/content';
---
<section class="bg-white px-4 py-12 md:px-10 lg:py-[90px]" data-section="TESTI-01">
  <div class="mx-auto flex max-w-[1170px] flex-col gap-8" data-slider="fade" data-autoplay="8">
    <div class="flex items-center justify-between">
      <Eyebrow>Customer spotlight</Eyebrow>
      <SliderNav />
    </div>
    <div class="grid overflow-hidden rounded border border-line">
      {
        testimonials.map((t, i) => (
          <figure class="col-start-1 row-start-1 flex flex-col bg-white md:flex-row md:items-center" data-slide aria-hidden={i === 0 ? undefined : 'true'} style={i === 0 ? undefined : 'visibility:hidden;opacity:0'}>
            <div class="h-[358px] w-full min-w-0 overflow-hidden md:h-[435px] md:flex-1" data-slide-part>
              <Media class="size-full" src={t.photo ?? undefined} alt={`Photo of ${t.name}`} />
            </div>
            <div class="flex min-w-0 flex-1 flex-col justify-between gap-10 p-6 md:h-[435px] lg:p-16" data-slide-part>
              <blockquote class="t-b1 text-black">{t.quote}</blockquote>
              <figcaption class="t-b3 flex flex-col gap-2">
                <span class="text-black">{t.name}</span>
                <span class="text-ink-2">{t.role}{t.company && `, ${t.company}`}</span>
              </figcaption>
            </div>
          </figure>
        ))
      }
    </div>
  </div>
</section>
