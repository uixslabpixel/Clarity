---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FeaturedPostHero from '../../components/sections/FeaturedPostHero.astro';
import BlogGrid from '../../components/sections/BlogGrid.astro';
import Newsletter from '../../components/sections/Newsletter.astro';
import { allPosts } from '../../data/posts';
const featured = allPosts.find((p) => p.featured)!;
---
<BaseLayout description="Governance briefings on regulation, leadership transitions, capital structure and operational resilience from Clarity’s partners." title="Insights" nav={{ active: '/insights' }}>
  <FeaturedPostHero post={featured} />
  <BlogGrid />
  <Newsletter />
</BaseLayout>
