---
import Media from '../ui/Media.astro';
interface Props {
  title: string;
  category: string;
  date: string;
  author: string;
  excerpt?: string;
  href?: string;
  imageHeight?: number;
  radius?: 'sm' | 'lg';
  class?: string;
  [key: string]: unknown;
}
const { title, category, date, author, excerpt, href = '#', imageHeight = 280, radius = 'lg', class: cls = '', slug: _slug, featured: _f, ...rest } = Astro.props;
---
<a href={href} {...rest} data-reveal class={`group flex min-w-0 flex-col gap-6 overflow-hidden ${radius === 'lg' ? 'rounded-lg' : 'rounded'} border border-line bg-white ${cls}`}>
  <div class="relative w-full shrink-0 overflow-hidden bg-black/20" style={`height:${imageHeight}px`}>
    <Media tone="duotone" class="absolute inset-0 size-full transition-transform duration-500 group-hover:scale-[1.03]" />
    <span class="t-label absolute left-4 top-4 bg-white/20 p-2 text-white">{category}</span>
  </div>
  <div class="flex flex-col gap-8 px-6 pb-6">
    <div class="flex flex-col gap-2">
      <h3 class="t-h5 line-clamp-2 min-h-[58px]">{title}</h3>
      <p class="t-label flex items-center gap-2 text-ink-3">
        <span>{date}</span><span class="h-3.5 w-px bg-black/20"></span><span>{author}</span>
      </p>
    </div>
    {excerpt && <p class="t-b3 line-clamp-2 text-ink-2">{excerpt}</p>}
  </div>
</a>
