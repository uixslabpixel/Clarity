---
/** HERO-03 — inset rounded hero image under a minimal nav (Home 3). */
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import VideoCard from '../ui/VideoCard.astro';
import { site } from '../../data/site';
import { img } from '../../data/images';
---
<section class="bg-white px-4 pb-4 pt-[60px] md:px-10 md:pb-10" data-section="HERO-03">
  <div class="relative flex min-h-[640px] flex-col justify-end overflow-hidden rounded bg-black p-4 pb-8 text-white md:min-h-[720px] md:p-10 lg:block lg:h-[804px] lg:min-h-0 lg:p-0">
    <Media src={img.heroTowers} tone="duotone" class="absolute inset-0 size-full scale-110" loading="eager" data-parallax="50" />
    <div class="absolute inset-0 bg-gradient-to-l from-transparent to-black/60"></div>
    <div class="relative flex flex-col gap-10 lg:absolute lg:inset-x-10 lg:top-1/2 lg:-translate-y-1/2 lg:flex-row lg:items-end lg:justify-between">
      <div class="flex flex-col gap-8 lg:w-[710px]">
        <div class="flex flex-col gap-4">
          {site.announcement.enabled && (
<a href={site.announcement.href} class="group flex flex-wrap items-center gap-x-4 gap-y-1">
            <span class="t-b4">{site.announcement.text}</span>
            <span class="flex items-center gap-1">
              <span class="t-b4 text-paper-2 transition-colors group-hover:text-white">{site.announcement.cta}</span>
              <span class="grid size-4 place-items-center rounded-full bg-black/10"><Icon name="chevron-right" size={8} /></span>
            </span>
          </a>
)}
          <h1 data-reveal class="t-hero">Engineering Enterprise Alpha governance.</h1>
        </div>
        <div data-reveal class="flex gap-4">
          <Button href="/contact" variant="light">Book a Call</Button>
          <Button href="/contact" variant="ghost-light" chevron={false}>Talk to Sales</Button>
        </div>
      </div>
      <VideoCard class="self-start lg:self-auto" />
    </div>
  </div>
</section>
