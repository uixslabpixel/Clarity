---
/** PROCESS-05 — heading + CTA left, step cards in a 2-col grid (Services 2). */
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { methodSteps } from '../../data/services';
---
<div class="flex flex-col items-stretch gap-10 lg:flex-row lg:items-start lg:justify-between" data-section="PROCESS-05">
  <div class="flex flex-col gap-6 lg:w-[420px] lg:gap-12">
    <div class="flex flex-col gap-3.5">
      <Eyebrow>How it works</Eyebrow>
      <h2 data-reveal class="t-h2">Delivering Alpha with Quantitative Methods</h2>
    </div>
    <Button href="/services/management-consulting" variant="soft" size="sm" class="self-start">Access Domain Strategy</Button>
  </div>
  <div class="grid w-full grid-cols-1 gap-x-[26px] gap-y-8 md:grid-cols-2 md:gap-y-6 lg:w-[618px]">
    {
      methodSteps.map((s) => (
        <article data-reveal class="flex flex-col gap-4">
          <div class="flex h-[200px] flex-col md:h-[296px] justify-between border border-line p-8">
            <span class="t-label text-ink-2">{s.label}</span>
            <Icon name={s.icon as any} size={48} class="text-zinc-300" />
          </div>
          <div class="flex flex-col gap-3">
            <h3 class="t-b3 text-black">{s.title}</h3>
            <p class="t-b4 text-ink-2">{s.text}</p>
          </div>
        </article>
      ))
    }
  </div>
</div>
