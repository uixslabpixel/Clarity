---
/** HERO-09 — article hero with author / date / read-time row (Blog Detail). */
import Breadcrumb from '../ui/Breadcrumb.astro';
import GradientWash from '../ui/GradientWash.astro';
import Media from '../ui/Media.astro';
interface Props {
  category: string;
  title: string;
  dek: string;
  author: string;
  date: string;
  readTime: string;
  cover?: string | null;
}
const { category, title, dek, author, date, readTime, cover } = Astro.props;
---
<section class="relative overflow-hidden bg-white pt-[61px]" data-section="HERO-09">
  <GradientWash class="inset-[-419px_0_683px_0]" />
  <div class="relative flex flex-col items-start gap-6 px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))] py-12 lg:flex-row lg:items-end lg:gap-8 lg:py-[68px]">
    <div class="flex w-full min-w-0 max-w-[800px] flex-col gap-4 lg:w-auto lg:flex-1">
      <Breadcrumb items={[{ label: 'Blog', href: '/insights' }, { label: category }]} />
      <h1 data-reveal class="t-h2 max-w-[672px]">{title}</h1>
    </div>
    <p class="t-b3 max-w-[500px] text-ink-2 lg:flex-1">{dek}</p>
  </div>
  <div class="relative px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))]">
    <Media src={cover ?? undefined} data-reveal="media" tone="duotone" class="h-[260px] w-full bg-black md:h-[400px] lg:h-[480px]" loading="eager" />
  </div>
  <dl class="relative flex flex-wrap items-end justify-between gap-6 px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))] pb-12 pt-8 lg:pb-16">
    <div class="flex items-center gap-4">
      <Media src="/images/lib/avatar-orange.webp" sizes="64px" class="size-10 rounded-full" alt={`Photo of ${author}`} />
      <div class="flex flex-col gap-1">
        <dt class="t-label text-ink-2">Author</dt>
        <dd class="t-h6">{author}</dd>
      </div>
    </div>
    <div class="flex flex-col gap-1">
      <dt class="t-label text-ink-2">Date</dt>
      <dd class="t-h6">{date}</dd>
    </div>
    <div class="flex flex-col gap-1">
      <dt class="t-label text-ink-2">Time to read</dt>
      <dd class="t-h6">{readTime}</dd>
    </div>
  </dl>
</section>
