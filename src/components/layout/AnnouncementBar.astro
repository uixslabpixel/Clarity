---
import Icon from '../ui/Icon.astro';
import GradientWash from '../ui/GradientWash.astro';
import { site } from '../../data/site';
const { text, cta, href } = site.announcement;
---
<a href={href} class="group relative flex w-full items-center justify-center gap-2 overflow-hidden bg-white px-6 py-3.5">
  <GradientWash class="inset-[-462px_0_-200px_0]" />
  <span class="t-b4 relative text-black">{text}</span>
  <span class="relative flex items-center gap-1">
    <span class="t-b4 text-black/60 transition-colors group-hover:text-black">{cta}</span>
    <span class="grid size-4 place-items-center rounded-full bg-black/10"><Icon name="chevron-right" size={8} /></span>
  </span>
</a>
