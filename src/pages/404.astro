---
import BaseLayout from '../layouts/BaseLayout.astro';
import GradientWash from '../components/ui/GradientWash.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="Not Found">
  <section class="relative h-[703px] overflow-hidden bg-white pt-[190px]" data-section="HERO-11">
    <GradientWash class="inset-[-419px_0_120px_0]" />
    <div class="relative mx-auto flex max-w-[480px] flex-col items-center text-center">
      <p aria-hidden="true" class="bg-gradient-to-b from-zinc-200 to-zinc-200/0 bg-clip-text font-heading text-[136px] leading-none text-transparent">404</p>
      <h1 class="t-h2 -mt-6">Metric Not Found</h1>
      <p class="t-b4 mt-10 max-w-[460px] text-ink-2">The systemic asset or operational documentation you are attempting to access has been relocated, archived, or removed from our servers.</p>
      <Button href="/" variant="soft" class="mt-4">Return to Core Framework</Button>
    </div>
  </section>
</BaseLayout>
