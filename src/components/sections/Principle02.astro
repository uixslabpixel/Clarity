---
/** PRINCIPLE-02 — vertical tabs with a large image (About 2). */
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import Media from '../ui/Media.astro';
import { principles } from '../../data/about';
import { img } from '../../data/images';
---
<section class="bg-white px-4 py-12 md:px-10 md:py-20" data-section="PRINCIPLE-02">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-10 lg:gap-16">
    <div class="flex flex-col gap-4">
      <Eyebrow>Core principles</Eyebrow>
      <span class="h-px w-full bg-line"></span>
      <div class="flex flex-col items-start gap-6 md:flex-row md:items-end md:justify-between md:gap-8">
        <h2 data-reveal class="t-h2">Our Practice's Core Principles</h2>
        <Button href="/contact" variant="soft">Book a Call</Button>
      </div>
    </div>
    <div class="flex flex-col items-stretch gap-8 lg:flex-row" data-accordion data-autoplay="7">
      <ol class="flex flex-col lg:w-[380px] lg:shrink-0">
        {
          principles.map((p, i) => (
            <li class="group relative flex flex-col border-t border-line data-open:min-h-[260px] data-open:bg-gradient-to-b data-open:from-[#f4f1ec]/0 data-open:to-[#f4f1ec] lg:data-open:h-[380px]" data-accordion-item data-open={i === 0 ? '' : undefined}>
              <span class="absolute -top-px left-0 h-px w-full origin-left bg-black" style={`transform:scaleX(${i === 0 ? 0.5 : 0})`} data-progress />
              <button type="button" class="t-h5 w-full px-4 pb-6 pt-6 text-left md:px-8 md:pb-8 md:pt-8 lg:group-data-open:pt-0" data-accordion-trigger>{p.title}</button>
              <div class="hidden flex-1 flex-col justify-end px-4 pb-6 group-data-open:flex md:px-8 md:pb-8" data-accordion-panel="fade">
                <p class="t-b3 text-ink-2">{p.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <Media src={img.meetingPresentation} data-reveal="media" class="h-[320px] md:h-[480px] lg:h-auto lg:min-w-0 lg:grow lg:basis-0" />
    </div>
  </div>
</section>
