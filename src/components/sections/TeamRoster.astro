---
/** TEAM-03 — full roster: faded portraits, bios and social links (Team). */
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import Hatch from '../ui/Hatch.astro';
import { team } from '../../data/content';
import { site } from '../../data/site';
---
<section class="relative overflow-hidden bg-[linear-gradient(180deg,rgb(244_241_236/0)_0%,#f4f1ec_100%)] px-[135px] pb-24 pt-32" data-section="TEAM-03">
  <Hatch class="absolute inset-x-0 top-0" />
  <div class="flex gap-14" data-slider>
    {
      team.map((m) => (
        <article class="flex w-[480px] shrink-0 flex-col gap-10">
          <div class="relative h-[600px] w-[480px] overflow-hidden">
            <Media class="absolute left-[50px] top-[169px] size-[430px] [mask-image:radial-gradient(closest-side,black_55%,transparent)]" alt={`Portrait of ${m.name}`} />
            <div class="absolute left-0 top-[41px] flex items-center gap-6">
              <span class="h-[52px] w-px bg-black/20" />
              <div class="flex w-[275px] flex-col gap-2">
                <h2 class="t-h5">{m.name}</h2>
                <p class="t-b3 text-ink-2">{m.role}</p>
              </div>
            </div>
          </div>
          <div class="flex items-start justify-between">
            <p class="t-b3 w-[380px] text-ink-2">{m.bio}</p>
            <div class="flex items-center gap-3 text-black">
              <a href={site.x} aria-label={`${m.name} on X`} class="opacity-70 hover:opacity-100"><Icon name="x" size={17} /></a>
              <span class="h-[17px] w-px bg-black/10" />
              <a href={site.linkedin} aria-label={`${m.name} on LinkedIn`} class="opacity-70 hover:opacity-100"><Icon name="linkedin" size={17} /></a>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
