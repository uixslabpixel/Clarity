---
/** SERVICE-02 — alternating image / copy rows (Services 2). */
import Button from '../ui/Button.astro';
import Media from '../ui/Media.astro';
import { services } from '../../data/services';
---
<div class="flex flex-col gap-12 lg:gap-16" data-section="SERVICE-02">
  {
    services.map((s, i) => (
      <article data-reveal class={`flex flex-col items-start gap-6 md:flex-row md:gap-8 ${i % 2 ? 'md:flex-row-reverse md:justify-between' : ''}`}>
        <Media src={s.cover ?? undefined} sizes="(min-width: 768px) 512px, 100vw" tone="duotone" class="aspect-square w-full shrink-0 md:w-[45%] xl:size-[512px]" />
        <div class={`flex w-full flex-col gap-6 pt-0 md:flex-1 md:gap-8 xl:flex-none ${i % 2 ? 'xl:w-[512px]' : 'xl:w-[492px]'}`}>
          <h2 data-reveal class="t-h5">{s.title}</h2>
          <div class="flex flex-col items-start gap-4">
            <p class="t-b3 text-ink-2">{s.text}</p>
            <Button href={`/services/${s.slug}`} variant="soft" size="sm">{s.cta}</Button>
          </div>
        </div>
      </article>
    ))
  }
</div>
