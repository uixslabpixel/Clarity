---
/** BANNER-01 — full-bleed photo banner with headline and CTA (Services). */
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';
import { img } from '../../data/images';
interface Props {
  title?: string;
  cta?: string;
  href?: string;
}
const { title = 'Access the 2026 Executive Infrastructure Blueprint', cta = 'Access Technical Asset Report', href = '/contact' } = Astro.props;
---
<section class="relative h-[520px] overflow-hidden md:h-[620px] lg:h-[720px] bg-black text-white" data-section="BANNER-01">
  <Media src={img.facadeGrid} tone="dark" class="absolute left-1/2 top-[-145px] h-[919px] w-[1470px] -translate-x-1/2" data-parallax="100" />
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="absolute inset-x-4 top-1/2 flex -translate-y-1/2 flex-col items-start gap-8 md:inset-x-10 lg:inset-x-0 lg:mx-auto lg:w-[min(1132px,calc(100%-80px))] lg:flex-row lg:items-center lg:justify-between">
    <h2 data-reveal class="t-h2 max-w-[654px] lg:w-[654px]">{title}</h2>
    <Button href={href} variant="light">{cta}</Button>
  </div>
</section>
