---
/** HERO-02 — full-bleed photo, left headline with inline announcement, video card, logo marquee (Home 2). */
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import ClientLogo from '../ui/ClientLogo.astro';
import { clients } from '../../data/content';
import { site } from '../../data/site';
const marquee = [...clients, ...clients];
---
<section class="relative h-[900px] overflow-hidden bg-black text-white" data-section="HERO-02">
  <Media tone="dark" class="absolute inset-0 size-full" loading="eager" />
  <div class="absolute inset-0 bg-[linear-gradient(236.58deg,transparent_10.7%,rgb(0_0_0/.4)_63.67%)]"></div>
  <div class="absolute left-1/2 top-[438px] flex w-[1360px] -translate-x-1/2 items-end justify-between">
    <div class="flex w-[710px] flex-col gap-8">
      <div class="flex flex-col gap-4">
        <a href={site.announcement.href} class="group flex items-center gap-4">
          <span class="t-b4">{site.announcement.text}</span>
          <span class="flex items-center gap-1">
            <span class="t-b4 opacity-60 transition-opacity group-hover:opacity-100">{site.announcement.cta}</span>
            <span class="grid size-4 place-items-center rounded-full bg-black/10"><Icon name="chevron-right" size={8} /></span>
          </span>
        </a>
        <h1 class="t-h1">Engineering Enterprise Alpha governance.</h1>
      </div>
      <div class="flex gap-4">
        <Button href="/contact" variant="light">Book a Call</Button>
        <Button href="/contact" variant="ghost" chevron={false}>Talk to Sales</Button>
      </div>
    </div>
    <button type="button" data-video-card class="group relative h-[164px] w-[254px] overflow-hidden rounded border border-white/10 bg-white/10 text-left backdrop-blur-[20px]">
      <Media tone="duotone" class="absolute inset-0 size-full transition-transform duration-500 group-hover:scale-105" />
      <span class="absolute inset-x-0 bottom-0 flex flex-col gap-2 bg-black/20 p-4">
        <span class="t-b4">Enterprise Alpha governance.</span>
        <span class="flex items-center gap-2">
          <span class="grid size-6 place-items-center rounded-full bg-white/20"><Icon name="play" size={8} /></span>
          <span class="t-b5 text-paper-2">Watch (1:30)</span>
        </span>
      </span>
    </button>
  </div>
  <div class="absolute inset-x-0 top-[856px] overflow-hidden [mask-image:linear-gradient(to_right,transparent,black_30%,black_70%,transparent)]" data-marquee>
    <div class="flex w-max items-center gap-[17px] text-white/80">
      {marquee.map((c) => <ClientLogo name={c} height={22} class="px-[11px]" />)}
    </div>
  </div>
</section>
