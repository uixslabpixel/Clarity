---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import GradientWash from '../../components/ui/GradientWash.astro';
import { legalPages } from '../../data/legal';
import { site } from '../../data/site';

export function getStaticPaths() {
  return legalPages.map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
---
<BaseLayout title={page.label}>
  <section class="relative overflow-hidden bg-white px-10 pb-[104px] pt-[165px]" data-section="LEGAL-01">
    <GradientWash class="inset-[-419px_0_auto_0] h-[710px]" />
    <div class="relative mx-auto flex max-w-[800px] flex-col gap-20">
      <header class="flex flex-col gap-8">
        <div class="flex flex-col gap-3.5">
          <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Legal' }]} />
          <h1 class="t-h2">{page.title}</h1>
        </div>
        <p class="t-b3 max-w-[550px] text-ink-2">{page.intro}</p>
      </header>
      <div class="flex flex-col">
        {
          page.sections.map((s, i) => (
            <section class={`flex flex-col gap-6 ${i === 0 ? 'pb-8' : i === page.sections.length - 1 ? 'pt-8' : 'py-8'} ${i < page.sections.length - 1 ? 'border-b border-line' : ''}`}>
              <h2 class="t-h5">{s.heading}</h2>
              {s.body.map((p) => <p class="t-b3 text-ink-2">{p}</p>)}
            </section>
          ))
        }
      </div>
      <footer class="t-label flex flex-col gap-4 text-ink-2">
        <span class="h-px w-full bg-line"></span>
        <div class="flex items-center justify-between">
          <span>Last revised: <span class="text-black">October 2026.</span></span>
          <span>For compliance, contact <a href={`mailto:${site.legalEmail}`} class="hover:text-black">{site.legalEmail}</a>.</span>
        </div>
      </footer>
    </div>
  </section>
</BaseLayout>
