---
/** Two-column doc layout: sticky "In this page" index + stacked panels (Style Guide, Changelog, Licenses). */
interface Props {
  toc: { id: string; label: string }[];
}
const { toc } = Astro.props;
---
<section class="bg-white px-[134px] pb-[120px]" data-section="DOCS">
  <div class="mx-auto flex max-w-[1172px] items-start justify-between">
    <nav aria-label="In this page" class="sticky top-24 flex w-[220px] flex-col gap-4" data-toc>
      <p class="t-label text-black">In this page</p>
      <ol class="flex flex-col border-l border-line">
        {
          toc.map((t, i) => (
            <li>
              <a href={`#${t.id}`} class={`t-b4 -ml-px block border-l py-1.5 pl-3 transition-colors ${i === 0 ? 'border-black text-black' : 'border-transparent text-ink-3 hover:text-black'}`}>{t.label}</a>
            </li>
          ))
        }
      </ol>
    </nav>
    <div class="flex w-[880px] flex-col gap-6"><slot /></div>
  </div>
</section>
