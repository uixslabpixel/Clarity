---
import BaseLayout from '../layouts/BaseLayout.astro';
import SimpleHero from '../components/sections/SimpleHero.astro';
---
<BaseLayout title="Password Protected">
  <SimpleHero title="Password protected" text="Your personal data and privacy are our top priorities." />
  <section class="bg-white px-[218px] pb-[104px]" data-section="PASSWORD-01">
    <div class="mx-auto flex max-w-[1004px] items-center gap-8 rounded bg-black/5 px-12 py-14">
      <div class="flex flex-1 flex-col gap-2">
        <h2 class="t-h4">Protected Portal</h2>
        <p class="t-b4 max-w-[420px] text-ink-2">This area is for authorized personnel and board members only. Enter your passcode to proceed.</p>
      </div>
      <form class="flex h-12 w-[426px] items-center gap-2 overflow-hidden rounded-lg border border-line bg-white/50 pl-4 pr-1" method="post" data-password>
        <label for="pw" class="sr-only">Password</label>
        <input id="pw" name="password" type="password" required placeholder="Enter Password" class="t-b4 min-w-0 flex-1 bg-transparent outline-none placeholder:text-zinc-400" />
        <button type="submit" class="t-b4 h-10 rounded bg-black px-3.5 text-white hover:bg-zinc-600">Send</button>
      </form>
    </div>
  </section>
</BaseLayout>
