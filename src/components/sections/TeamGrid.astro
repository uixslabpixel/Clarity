---
/** TEAM-02b — header with CTA + three portrait cards (Home 3). */
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import TeamCard from '../cards/TeamCard.astro';
import { team } from '../../data/content';
---
<section class="bg-white px-10 py-20" data-section="TEAM-02b">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-16">
    <SectionHeader eyebrow="Our team" title="Led by Experienced Practitioners">
      <Button href="/team" variant="soft">View Full Leadership Team</Button>
    </SectionHeader>
    <div class="flex items-center gap-4">
      {team.slice(0, 3).map((m) => <TeamCard name={m.name} role={m.role} />)}
    </div>
  </div>
</section>
