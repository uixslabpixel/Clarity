---
/** PROCESS-04 — three method steps; the active one expands (Services 1). */
import SectionHeader from '../ui/SectionHeader.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import { methodSteps } from '../../data/services';
---
<section class="bg-white px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))] pb-12 pt-12 md:pt-20 lg:pb-[104px]" data-section="PROCESS-04">
  <div class="mx-auto flex max-w-[1132px] flex-col gap-10 lg:gap-20">
    <SectionHeader eyebrow="How it works" title="Delivering Alpha via Quantitative Methods" width={704}>
      <Button href="/services/management-consulting" variant="soft">Access Domain Strategy</Button>
    </SectionHeader>
    <ol class="flex flex-col items-stretch gap-4 lg:flex-row lg:items-start lg:gap-6" data-accordion>
      {
        methodSteps.map((s, i) => (
          <li
            class="group flex min-w-0 cursor-pointer flex-col justify-between gap-4 border-l border-line px-6 py-6 transition-[flex-basis,flex-grow,background-color] duration-500 ease-[cubic-bezier(.65,0,.35,1)] hover:bg-black/[.02] data-open:min-h-[260px] data-open:gap-8 data-open:bg-gradient-to-b data-open:from-[#f4f1ec]/0 data-open:to-[#f4f1ec] data-open:py-8 lg:h-[300px] lg:basis-0 lg:grow lg:py-8 lg:data-open:shrink-0 lg:data-open:grow-0 lg:data-open:basis-[476px]"
            data-accordion-item
            data-accordion-click
            data-open={i === 0 ? '' : undefined}
          >
            <div class="flex items-start justify-between">
              <Icon name={s.icon as any} size={56} class="hidden text-zinc-300 group-data-open:block" />
              <span class="t-label text-ink-2">{s.label}</span>
            </div>
            <div class="flex flex-col gap-2">
              <h3 class="t-h5"><button type="button" class="text-left" data-accordion-trigger>{s.title}</button></h3>
              <div class="hidden group-data-open:block" data-accordion-panel="fade">
                <p class="t-b3 line-clamp-3 text-ink-2">{s.text}</p>
              </div>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
