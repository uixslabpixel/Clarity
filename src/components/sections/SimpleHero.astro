---
/** HERO-12 — simple centred title hero on the gradient wash (utility pages). */
import GradientWash from '../ui/GradientWash.astro';
interface Props {
  title: string;
  text?: string;
  maxWidth?: number;
}
const { title, text, maxWidth = 560 } = Astro.props;
---
<section class="relative overflow-hidden bg-white px-4 pb-16 pt-[120px] md:px-10 lg:pb-[104px] lg:pt-[165px]" data-section="HERO-12">
  <GradientWash class="inset-[-419px_0_120px_0]" />
  <div class="relative mx-auto flex flex-col items-center gap-6 text-center" style={`max-width:${maxWidth}px`}>
    <h1 class="t-h2">{title}</h1>
    {text && <p class="t-b3 text-ink-2">{text}</p>}
  </div>
</section>
