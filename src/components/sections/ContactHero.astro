---
/** HERO-10 — contact intro, office details and discovery form (light or photo variant). */
import Breadcrumb from '../ui/Breadcrumb.astro';
import GradientWash from '../ui/GradientWash.astro';
import Media from '../ui/Media.astro';
import Icon from '../ui/Icon.astro';
import ContactForm from '../forms/ContactForm.astro';
import { img } from '../../data/images';
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
const dark = variant === 'dark';
---
<section class={`relative overflow-hidden px-4 md:px-10 lg:px-[max(40px,calc((100%-1170px)/2))] pb-12 pt-[120px] lg:pb-[104px] lg:pt-[157px] ${dark ? 'bg-black text-white' : 'bg-white'}`} data-section="HERO-10">
  {
    dark ? (
      <>
        <Media src={img.glassPrism} tone="dark" class="absolute inset-0 size-full" loading="eager" />
        <div class="absolute inset-0 bg-black/50" />
      </>
    ) : (
      <>
        <GradientWash class="inset-[-419px_0_553px_0]" />
        <div aria-hidden="true" class="pointer-events-none absolute right-[88px] top-[119px] hidden size-[659px] lg:block [background-image:repeating-linear-gradient(90deg,rgb(0_0_0/.06)_0_1px,transparent_1px_8px)] [mask-image:radial-gradient(closest-side,black,transparent)]" />
      </>
    )
  }
  <div class="relative mx-auto flex max-w-[1170px] flex-col items-stretch gap-12 lg:flex-row lg:items-start lg:gap-10 xl:gap-20">
    <div class="flex shrink-0 flex-col justify-between gap-10 self-stretch lg:w-[380px] xl:w-[525px]">
      <div class="flex flex-col gap-4">
        <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Contact' }]} tone={dark ? 'light' : 'dark'} />
        <div class="flex flex-col gap-6">
          <h1 data-reveal class="t-h2">Initiate Corporate Discovery</h1>
          <p class={`t-b3 ${dark ? 'text-paper-2' : 'text-ink-2'}`}>Structural modernization of business operations, board-level scenario planning, and systemic mitigation of regulatory friction.</p>
        </div>
      </div>
      {
        !dark && (
          <div class="flex flex-col items-start gap-6 md:flex-row md:gap-[35px]">
            <div class="flex flex-1 flex-col justify-center gap-4 md:h-[127px]">
              <span class="grid size-8 place-items-center rounded-full bg-black/5"><Icon name="building" size={14} /></span>
              <div class="flex flex-col gap-2 text-ink-2">
                <p class="t-label">Corporate Advisory Base</p>
                <p class="t-b3 line-clamp-2">One Financial District Tower, Suite 4800, New York, NY 10005.</p>
              </div>
            </div>
            <span class="h-px w-full bg-line md:h-auto md:w-px md:self-stretch" />
            <div class="flex flex-1 flex-col justify-center gap-4 md:h-[127px]">
              <span class="grid size-8 place-items-center rounded-full bg-black/5"><Icon name="location" size={14} /></span>
              <div class="flex flex-col gap-2 text-ink-2">
                <p class="t-label">Regional Advisory Centers</p>
                <p class="t-b3">London Corporate Hub (EMEA)<br />Singapore Financial Core (APAC)</p>
              </div>
            </div>
          </div>
        )
      }
    </div>
    <div class="min-w-0 text-black"><ContactForm /></div>
  </div>
</section>
