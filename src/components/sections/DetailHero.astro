---
/** HERO-06 — breadcrumb + title left, intro right, wide image (Service Detail). */
import Breadcrumb from '../ui/Breadcrumb.astro';
import GradientWash from '../ui/GradientWash.astro';
import Media from '../ui/Media.astro';
interface Props {
  parent: { label: string; href: string };
  crumb: string;
  title: string;
  text: string;
  cover?: string | null;
}
const { parent, crumb, title, text, cover } = Astro.props;
---
<section class="relative overflow-hidden bg-white pb-12 pt-[61px] lg:pb-16" data-section="HERO-06">
  <GradientWash class="inset-[-419px_0_607px_0]" />
  <div class="relative flex flex-col items-start gap-6 px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))] py-12 lg:flex-row lg:items-end lg:gap-8 lg:py-[68px]">
    <div class="flex w-full min-w-0 max-w-[800px] flex-col gap-4 lg:w-auto lg:flex-1">
      <Breadcrumb items={[parent, { label: crumb }]} />
      <h1 class="t-h2 max-w-[672px]">{title}</h1>
    </div>
    <p class="t-b3 max-w-[500px] text-ink-2 lg:flex-1">{text}</p>
  </div>
  <div class="relative px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))]">
    <Media src={cover ?? undefined} tone="duotone" class="h-[260px] w-full bg-black md:h-[400px] lg:h-[480px]" loading="eager" />
  </div>
</section>
