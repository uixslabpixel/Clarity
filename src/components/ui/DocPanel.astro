---
interface Props {
  id: string;
  title: string;
  intro?: string;
  meta?: string;
}
const { id, title, intro, meta } = Astro.props;
---
<section id={id} class="flex scroll-mt-24 flex-col gap-4 border border-black/10 bg-black/[.02] p-10">
  <div class="flex flex-col gap-1.5">
    <div class="flex items-center justify-between">
      <h2 class="t-label text-black">{title}</h2>
      {meta && <span class="t-label text-black">{meta}</span>}
    </div>
    {intro && <p class="t-b4 max-w-[540px] text-ink-2">{intro}</p>}
  </div>
  <span class="h-px w-full bg-zinc-200"></span>
  <div><slot /></div>
</section>
