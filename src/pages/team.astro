---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/sections/PageHero.astro';
import Media from '../components/ui/Media.astro';
import { img } from '../data/images';
import TeamRoster from '../components/sections/TeamRoster.astro';
import QuoteCollage from '../components/sections/QuoteCollage.astro';
import Callout from '../components/ui/Callout.astro';
import Button from '../components/ui/Button.astro';
import CTA from '../components/layout/CTA.astro';
---
<BaseLayout description="Meet the Advisory Council: veteran C-suite operators, turnaround specialists and governance architects who lead every Clarity engagement." title="Team" nav={{ active: '/team' }}>
  <PageHero
    crumb="Team"
    title="The Advisory Council"
    text="A cross-functional group of veteran C-suite practitioners, tactical asset specialists, and corporate governance architects."
  >
    <Media src={img.facadeFins} tone="duotone" class="h-[480px] w-full" loading="eager" />
  </PageHero>
  <TeamRoster />
  <QuoteCollage />
  <Callout eyebrow="The Sovereign Operational Standard" title="Senior Partners have limited emergency seats on boards, councils, or interim management during transitions." class="px-4 pb-12 pt-0 md:px-10 lg:px-[max(40px,calc((100%-1004px)/2))] lg:pb-14">
    <Button href="/contact" variant="soft" class="!bg-black/10">Initiate Crisis Protocol</Button>
  </Callout>
  <CTA title="Retain Elite Fractional Leadership for Your Firm" cta="Request Partner Consultation" />
</BaseLayout>
