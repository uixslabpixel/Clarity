---
import { footerColumns } from '../../data/site';
interface Props {
  tone?: 'light' | 'dark';
}
const { tone = 'light' } = Astro.props;
const dark = tone === 'dark';
---
<div class={`t-b4 flex w-full items-start justify-between gap-4 lg:w-[456px] ${dark ? 'text-paper-2' : 'text-ink-2'}`}>
  {
    footerColumns.map((col) => (
      <div class="flex flex-1 flex-col gap-4">
        <p class={`t-label ${dark ? 'text-white' : ''}`}>{col.title}</p>
        <ul class="flex flex-col gap-[11px]">
          {col.links.map((l) => (
            <li>
              <a href={l.href} class={`transition-colors ${dark ? 'hover:text-white' : 'hover:text-black'}`}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>
    ))
  }
</div>
