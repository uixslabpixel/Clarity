---
import Eyebrow from './Eyebrow.astro';
interface Props {
  eyebrow?: string;
  title: string;
  tone?: 'dark' | 'light';
  width?: number;
  align?: 'left' | 'center';
  divider?: boolean;
  class?: string;
}
const { eyebrow, title, tone = 'dark', width = 480, align = 'left', divider = false, class: cls = '' } = Astro.props;
const hasAction = Astro.slots.has('default');
---
<div class={`flex w-full ${hasAction ? 'flex-col items-start gap-6 md:flex-row md:items-end md:justify-between md:gap-8' : align === 'center' ? 'justify-center' : ''} ${cls}`}>
  <div class={`flex flex-col gap-2 md:gap-3.5 ${align === 'center' ? 'items-center text-center' : ''}`} style={`max-width:${width}px;width:100%`}>
    {eyebrow && <Eyebrow tone={tone === 'light' ? 'light' : 'dark'}>{eyebrow}</Eyebrow>}
    {divider && <span class={`h-px w-full ${tone === 'light' ? 'bg-white/10' : 'bg-line'}`} />}
    <h2 class={`t-h2 ${tone === 'light' ? 'text-white' : 'text-black'}`} set:html={title} />
  </div>
  <slot />
</div>
