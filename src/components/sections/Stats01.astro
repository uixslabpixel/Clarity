---
/** STATS-01 — dark split: heading left, numbered rows right (Home 1). */
import Eyebrow from '../ui/Eyebrow.astro';
import { stats } from '../../data/content';
interface Props {
  eyebrow?: string;
  title?: string;
  items?: { value: string; label: string }[];
}
const { eyebrow = 'Number', title = 'Institutional Progress Delivered', items = stats } = Astro.props;
---
<section class="bg-black px-4 py-12 text-white md:px-10 lg:py-[88px]" data-section="STATS-01">
  <div class="mx-auto flex max-w-[1170px] flex-col items-start gap-10 lg:flex-row lg:gap-8">
    <div class="flex w-full max-w-[480px] flex-1 flex-col gap-2 lg:gap-3.5">
      <Eyebrow tone="light">{eyebrow}</Eyebrow>
      <h2 class="t-h2">{title}</h2>
    </div>
    <dl class="flex w-full flex-1 flex-col gap-6 lg:gap-10">
      {
        items.map((s) => (
          <div class="flex flex-col gap-8 border-t border-white/20 pt-6 lg:pt-8">
            <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
              <dt class="t-h1" data-count>{s.value}</dt>
              <dd class="t-b4 text-paper-2 md:w-[292px] lg:text-[16px] lg:leading-[1.3]">{s.label}</dd>
            </div>
          </div>
        ))
      }
    </dl>
  </div>
</section>
