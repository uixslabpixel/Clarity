---
/** PILLAR-01 — dark split: accordion list + swapping image stack (Home 1). */
import Eyebrow from '../ui/Eyebrow.astro';
import Icon from '../ui/Icon.astro';
import Media from '../ui/Media.astro';
import { pillars } from '../../data/content';

interface Props {
  eyebrow?: string;
  title?: string;
  items?: { title: string; text: string }[];
}
const { eyebrow = 'Core pillars', title = 'Core Pillars of Architecture', items = pillars } = Astro.props;
---
<section class="bg-black px-4 py-12 text-white md:px-10 lg:py-[98px]" data-section="PILLAR-01">
  <div
    class="mx-auto grid max-w-[1170px] grid-cols-1 gap-x-16 gap-y-12 lg:grid-cols-[minmax(0,600px)_minmax(0,575px)] lg:grid-rows-[auto_1fr] lg:justify-between lg:gap-y-0"
    data-accordion
    data-active="0"
  >
    <div class="flex flex-col gap-2 lg:col-start-1 lg:row-start-1 lg:gap-3.5">
      <Eyebrow tone="light">{eyebrow}</Eyebrow>
      <h2 class="t-h2 lg:max-w-[400px]">{title}</h2>
    </div>
    <div class="flex h-[337px] flex-col gap-3 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:h-auto lg:gap-4" data-accordion-media>
      <Media tone="dark" class="h-[168px] w-full shrink-0 rounded lg:h-[519px]" />
      {items.slice(1).map(() => <Media tone="dark" class="min-h-0 w-full flex-1 rounded opacity-30" />)}
    </div>
    <ul class="flex flex-col gap-4 lg:col-start-1 lg:row-start-2 lg:gap-6 lg:pt-[396px]">
      {
        items.map((item, i) => (
          <li class={`flex flex-col gap-2 ${i > 0 ? 'border-t border-white/20 pt-4 lg:pt-6' : ''}`} data-accordion-item data-open={i === 0 ? '' : undefined}>
            <button type="button" class="group flex w-full items-center gap-4 text-left" aria-expanded={i === 0 ? 'true' : 'false'}>
              <span class={`grid size-4 shrink-0 place-items-center rounded-full bg-white/10 ${i === 0 ? '' : 'hidden'}`} data-accordion-icon>
                <Icon name="chevron-right" size={8} />
              </span>
              <span class={i === 0 ? 't-h6 flex-1 text-white lg:text-[24px] lg:leading-[1.2] lg:tracking-normal' : 't-b3 flex-1 text-paper-3 transition-colors group-hover:text-white'}>{item.title}</span>
            </button>
            {i === 0 && <p class="t-b4 pl-8 text-paper-2 lg:text-[16px] lg:leading-[1.3] lg:text-white" data-accordion-panel>{item.text}</p>}
          </li>
        ))
      }
    </ul>
  </div>
</section>
