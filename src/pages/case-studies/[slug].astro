---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CaseHero from '../../components/sections/CaseHero.astro';
import ArticleBody from '../../components/sections/ArticleBody.astro';
import CTA from '../../components/layout/CTA.astro';

export async function getStaticPaths() {
  const entries = await getCollection('caseStudies');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const cs = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
---
<BaseLayout title={cs.shortTitle} description={cs.title} image={cs.cover ?? undefined} ogType="article" nav={{ active: '/case-studies' }}>
  <CaseHero
    cover={cs.cover}
    area={cs.area}
    title={cs.shortTitle}
    metric={cs.metric}
    metricLabel={cs.metricLabel}
    meta={[
      { label: 'Client Organization', value: cs.client },
      { label: 'Deployed Practice Area', value: cs.practice },
      { label: 'Transformation Frame', value: cs.timeframe },
    ]}
  />
  <ArticleBody toc={toc}>
    <Content />
  </ArticleBody>
  <CTA title="Accelerate Your Operational Evolution" cta="Schedule an Initiative Mapping Call" />
</BaseLayout>
