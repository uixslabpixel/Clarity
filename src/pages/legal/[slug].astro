---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/ui/Breadcrumb.astro';
import GradientWash from '../../components/ui/GradientWash.astro';
import { legalPages } from '../../data/legal';
import { site } from '../../data/site';

export function getStaticPaths() {
  return legalPages.map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}
const { page } = Astro.props;
---
<BaseLayout title={page.label}>
  <section class="relative overflow-hidden bg-white px-10 pb-[120px] pt-[165px]" data-section="LEGAL-01">
    <GradientWash class="inset-[-419px_0_auto_0] h-[710px]" />
    <div class="relative mx-auto flex max-w-[800px] flex-col">
      <header class="flex flex-col gap-4 pb-10">
        <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: 'Legal' }]} />
        <h1 class="t-h2">{page.title}</h1>
        <p class="t-b4 max-w-[520px] text-ink-2">{page.intro}</p>
      </header>
      {
        page.sections.map((s, i) => (
          <section class={`flex flex-col gap-4 py-6 ${i < page.sections.length - 1 ? 'border-b border-line' : ''}`}>
            <h2 class="t-h5">{s.heading}</h2>
            {s.body.map((p) => <p class="t-b4 text-ink-2">{p}</p>)}
          </section>
        ))
      }
      <footer class="t-label mt-10 flex justify-between border-t border-line pt-3 text-ink-2">
        <span>Last revised: <span class="text-black">October 2026.</span></span>
        <span>For compliance, contact <a href={`mailto:${site.legalEmail}`} class="text-black hover:underline">{site.legalEmail}</a></span>
      </footer>
    </div>
  </section>
</BaseLayout>
