---
/** STATS-05 — "Portfolio Performance Secured": two large metrics + logo strip (Case Studies). */
import Eyebrow from '../ui/Eyebrow.astro';
import LogoStrip from '../ui/LogoStrip.astro';
import { portfolioStats } from '../../data/cases';
---
<section class="bg-white px-4 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))] py-12 md:py-20" data-section="STATS-05">
  <div class="mx-auto flex max-w-[1132px] flex-col items-center gap-10 md:gap-14">
    <div class="flex w-full max-w-[600px] flex-col items-center gap-3.5 text-center">
      <Eyebrow>Number performance</Eyebrow>
      <h2 data-reveal class="t-h2">Portfolio Performance Secured</h2>
    </div>
    <div class="flex w-full flex-col items-center gap-8 md:flex-row md:justify-center lg:gap-16">
      {
        portfolioStats.map((s, i) => (
          <>
            {i > 0 && <span class="h-px w-full bg-line md:h-[97px] md:w-px" />}
            <div data-reveal class="flex w-full flex-col items-center gap-4 text-center md:flex-1 lg:w-[400px] lg:flex-none">
              <p class="flex items-baseline gap-2 font-heading">
                <span class="t-h1">{s.value}</span>
                {s.unit && <span class="t-h5 text-ink-3">{s.unit}</span>}
              </p>
              <p class="t-b3 max-w-[330px] text-ink-2">{s.label}</p>
            </div>
          </>
        ))
      }
    </div>
    <LogoStrip items={['Vexum', 'Deepstack', 'Wellnex', 'Botanic', 'Veeta', 'Owlearn']} />
  </div>
</section>
