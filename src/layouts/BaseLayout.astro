---
import '../styles/global.css';
import Footer, { type FooterVariant } from '../components/layout/Footer.astro';
import Navbar, { type NavLayout, type NavTheme } from '../components/layout/Navbar.astro';
import AnnouncementBar from '../components/layout/AnnouncementBar.astro';
import { site } from '../data/site';

interface Props {
  title: string;
  description?: string;
  footer?: FooterVariant | false;
  nav?: { layout?: NavLayout; theme?: NavTheme; active?: string } | false;
  announcement?: boolean;
  bodyClass?: string;
  noindex?: boolean;
  /** Social preview image (absolute or site-relative). */
  image?: string;
  ogType?: 'website' | 'article';
}
const {
  title,
  noindex = false,
  image = '/og.jpg',
  ogType = 'website',
  description = 'Clarity — fractional executive leadership and operational governance for enterprise transitions.',
  footer = 'boxed',
  nav = {},
  announcement = false,
  bodyClass = '',
} = Astro.props;
const fullTitle = title === 'Clarity' ? title : `${title} — Clarity`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en" data-video-url={site.videoUrl || undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="theme-color" content="#000000" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class={bodyClass}>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
    {
      nav && (
        <div class="absolute inset-x-0 top-0 z-40" data-site-header>
          {announcement && site.announcement.enabled && <AnnouncementBar />}
          <Navbar {...nav} />
        </div>
      )
    }
    <main id="main" class="relative">
      <slot />
    </main>
    {footer && <Footer variant={footer} />}
    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
