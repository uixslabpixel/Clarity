---
/** Hidden fields every form needs: Netlify form name + honeypot. */
interface Props {
  name: string;
}
const { name } = Astro.props;
---
<input type="hidden" name="form-name" value={name} />
<p class="sr-only" aria-hidden="true">
  <label>Leave this field empty <input name="company-website" tabindex="-1" autocomplete="off" /></label>
</p>
