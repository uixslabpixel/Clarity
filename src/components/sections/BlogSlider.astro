---
/** BLOG-02 — briefing cards slider with arrows (Home 3). */
import SectionHeader from '../ui/SectionHeader.astro';
import SliderNav from '../ui/SliderNav.astro';
import Hatch from '../ui/Hatch.astro';
import BlogCard from '../cards/BlogCard.astro';
import { posts } from '../../data/content';
const items = [...posts, ...posts];
---
<section class="overflow-hidden bg-white px-10 pb-[60px] pt-20" data-section="BLOG-02">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-12">
    <SectionHeader eyebrow="Blog" title="Governance Briefings" width={300} />
    <div class="flex flex-col gap-6" data-slider>
      <div class="flex gap-4" data-track>
        {items.map((p) => <BlogCard {...p} category="Corporate Strategy Hub" href={`/insights/${p.slug}`} class="w-[368px] shrink-0" />)}
      </div>
      <SliderNav />
    </div>
  </div>
  <Hatch class="relative left-1/2 mt-12 w-screen max-w-[1440px] -translate-x-1/2" />
</section>
