---
import Eyebrow from '../ui/Eyebrow.astro';
import Button from '../ui/Button.astro';
import GradientWash from '../ui/GradientWash.astro';

interface Props {
  eyebrow?: string;
  title: string;
  cta: string;
  href?: string;
}
const { eyebrow = 'Get a demo', title, cta, href = '/contact' } = Astro.props;
---
<section class="relative overflow-hidden bg-white px-10 py-[184px]">
  <GradientWash from="bottom" class="inset-[291px_0_-411px_0]" />
  <div class="relative mx-auto flex max-w-[648px] flex-col items-center gap-8 text-center">
    <div class="flex w-full flex-col gap-2">
      <Eyebrow>{eyebrow}</Eyebrow>
      <h2 class="t-h2 text-balance">{title}</h2>
    </div>
    <Button href={href}>{cta}</Button>
  </div>
</section>
