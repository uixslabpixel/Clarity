---
/** HERO-04 — centered page hero with breadcrumb and gradient wash. */
import Breadcrumb from '../ui/Breadcrumb.astro';
import GradientWash from '../ui/GradientWash.astro';

interface Props {
  crumb: string;
  title: string;
  text?: string;
  maxWidth?: number;
  hatch?: boolean;
}
const { crumb, title, text, maxWidth = 610 } = Astro.props;
const hasMedia = Astro.slots.has('default');
---
<section class={`relative overflow-hidden bg-white pt-[165px] ${hasMedia ? 'pb-[72px]' : 'pb-[104px]'}`} data-section="HERO-04">
  <GradientWash class="inset-[-419px_0_236px_0]" />
  <div class="relative mx-auto flex flex-col items-center gap-10 text-center" style={`max-width:${maxWidth}px`}>
    <div class="flex w-full flex-col items-center gap-3.5">
      <Breadcrumb items={[{ label: 'Home', href: '/' }, { label: crumb }]} />
      <h1 class="t-h2" set:html={title} />
    </div>
    {text && <p class="t-b3 text-ink-2">{text}</p>}
  </div>
  {hasMedia && <div class="relative mx-auto mt-[104px] w-[1170px]"><slot /></div>}
</section>
