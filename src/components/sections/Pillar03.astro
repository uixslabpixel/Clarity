---
/** PILLAR-03 — 2×2 cards: summary row + large icon + bullet list (Home 3). */
import SectionHeader from '../ui/SectionHeader.astro';
import Icon from '../ui/Icon.astro';
import Hatch from '../ui/Hatch.astro';
import { pillars } from '../../data/content';
---
<section class="bg-white px-4 pb-12 pt-12 md:px-10 md:pb-[60px] md:pt-20" data-section="PILLAR-03">
  <div class="mx-auto flex max-w-[1360px] flex-col gap-10 md:gap-12">
    <SectionHeader eyebrow="Core pillars" title="Core Pillars of Architecture" width={1360} />
    <div class="grid grid-cols-1 items-start gap-4 md:gap-6 xl:grid-cols-2">
      {
        pillars.map((p) => (
          <article data-reveal class="flex flex-col overflow-hidden rounded-lg border border-line">
            <div class="flex flex-col items-start gap-2 border-b border-black/[.11] p-6 md:flex-row md:gap-8 md:p-8">
              <h3 class="t-h5 shrink-0 md:w-[244px]">{p.card ?? p.short}</h3>
              <p class="t-b3 line-clamp-2 text-ink-2">{p.summary}</p>
            </div>
            <div class="flex flex-col items-stretch gap-6 p-6 md:flex-row md:items-start md:gap-8 md:p-8">
              <div class="grid h-[160px] shrink-0 place-items-center text-zinc-300 md:size-[244px]">
                <Icon name={p.icon as any} size={80} />
              </div>
              <ul class="flex min-w-0 flex-1 flex-col">
                {p.bullets.map((b) => (
                  <li class="t-b3 border-b border-black/[.11] py-4 text-ink-2">{b}</li>
                ))}
              </ul>
            </div>
          </article>
        ))
      }
    </div>
  </div>
  <Hatch class="-mx-4 w-auto md:-mx-10 mt-12" />
</section>
