---
import Media from '../ui/Media.astro';
import Button from '../ui/Button.astro';
interface Props {
  slug: string;
  client: string;
  area: string;
  title: string;
  metric: string;
  metricLabel: string;
  industry?: string;
  cover?: string | null;
}
const { slug, client, area, title, metric, metricLabel, industry, cover } = Astro.props;
---
<article data-reveal class="group flex flex-col items-stretch overflow-hidden border md:flex-row md:items-center border-black/[.11]" data-filter-item={industry}>
  <div class="relative h-[240px] min-w-0 overflow-hidden md:h-[435px] md:flex-1">
    <Media src={cover ?? undefined} sizes="(min-width: 768px) 600px, 100vw" tone="duotone" class="absolute inset-0 size-full transition-transform duration-700 group-hover:scale-[1.03]" />
  </div>
  <div class="flex w-full shrink-0 flex-col justify-between gap-8 bg-white p-5 md:h-[435px] md:w-1/2 md:px-8 md:py-8 lg:w-[566px] lg:px-12 lg:py-10">
    <div class="flex flex-col gap-2">
      <p class="t-label flex items-center gap-2 text-ink-2"><span>{client}</span><span class="h-3.5 w-px bg-black/20"></span><span>{area}</span></p>
      <h2 class="t-h5 max-w-[400px]">{title}</h2>
    </div>
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div class="flex flex-col gap-4">
        <p class="t-h2">{metric}</p>
        <p class="t-b3 text-ink-2">{metricLabel}</p>
      </div>
      <Button href={`/case-studies/${slug}`} variant="soft" class="!h-9">Read More</Button>
    </div>
  </div>
</article>
