---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostHero from '../../components/sections/PostHero.astro';
import ArticleBody from '../../components/sections/ArticleBody.astro';
import Blog01 from '../../components/sections/Blog01.astro';
import CTA from '../../components/layout/CTA.astro';
import { allPosts } from '../../data/posts';

export async function getStaticPaths() {
  const entries = await getCollection('posts');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const post = allPosts.find((p) => p.slug === entry.id)!;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text }));
const related = allPosts.filter((p) => p.slug !== post.slug && !p.featured).slice(0, 3);
---
<BaseLayout title={post.title} description={post.excerpt} nav={{ active: '/insights' }}>
  <PostHero
    category={post.category}
    title={post.title}
    dek={post.dek || post.excerpt}
    author={post.author}
    date={post.longDate}
    readTime={post.readTime}
    cover={post.cover}
  />
  <ArticleBody toc={toc}>
    <Content />
    {post.tags.length > 0 && (
    <div class="!mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-4">
      <span class="t-label text-ink-2">Tag</span>
      <div class="t-label flex flex-wrap gap-4 text-black">
        {post.tags.map((t) => <a href="/insights" class="hover:underline">/{t}</a>)}
      </div>
    </div>
    )}
  </ArticleBody>
  <Blog01 title="" posts={related as any} class="px-4 pb-12 md:px-10 lg:px-[max(40px,calc((100%-1132px)/2))] lg:pb-20" />
  <CTA title="Accelerate Your Operational Evolution" cta="Schedule an Initiative Mapping Call" />
</BaseLayout>
